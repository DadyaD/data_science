     ]
    }
   ],
   "source": [
    "best_model_forest = None\n",
    "best_result_forest =100\n",
    "best_est_forest = 0\n",
    "best_depth_forest = 0\n",
    "best_r2_forest=0\n",
    "for est in range(50,70,10):\n",
    "    for depth in range (1,5):\n",
    "        model_forest = RandomForestRegressor(random_state=3424,n_estimators=est,max_depth=None)\n",
    "        model_forest.fit(features_train_scaled, target_train)\n",
    "        predictions_forest = model_forest.predict(features_valid_scaled)\n",
    "        result_forest = root_mean_squared_error(target_valid, predictions_forest)\n",
    "        r2_forest = r2_score(target_valid, predictions_forest)\n",
    "        if result_forest < best_result_forest:\n",
    "            best_model_forest = model_forest\n",
    "            best_r2_forest=r2_forest\n",
    "            best_result_forest = result_forest\n",
    "            best_est_forest = est\n",
    "            best_depth_forest = depth\n",
    "print('RMSE лучшей модели:',best_result_forest,\n",
    "      \"Количество деревьев:\", best_est_forest,'Глубина леса:',best_depth_forest, 'лучший коэфициент детерминации:',best_r2_forest)"
   ]
