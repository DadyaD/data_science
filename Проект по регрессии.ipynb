   "source": [
    "### Подготовка данных для обучения моделей"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "67ecba9c",
   "metadata": {},
   "source": [
    "Разобьем выборку на обучающую, валидационную и тестовую"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "ee5bed10",
   "metadata": {},
   "outputs": [],
   "source": [
    "target = data['average_fare']\n",
    "features = data.drop(['average_fare'],axis=1)\n",
    "features_train, features_valid, target_train, target_valid = train_test_split(\n",
    "        features, target, test_size=0.40, random_state=3424)\n",
    "features_test, features_valid, target_test, target_valid = train_test_split(\n",
    "        features_valid, target_valid, test_size=0.50, random_state=3424)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6a36d9db",
   "metadata": {},
   "source": [
    "Произведем масштабирование признаков"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "199058f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "scaler = StandardScaler()\n",
    "features_train_scaled = features_train.copy()\n",
    "features_valid_scaled = features_valid.copy()\n",
    "features_test_scaled = features_test.copy()\n",
    "scaler.fit(features_train)\n",
    "features_train_scaled = scaler.transform(features_train)\n",
    "features_valid_scaled = scaler.transform(features_valid)\n",
    "features_test_scaled = scaler.transform(features_test)\n",
    "pd.options.mode.chained_assignment = None"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "41f187e7",
   "metadata": {},
   "source": [
    "Модель дерева решений"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "8a34d0c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "RMSE лучшей модели: 12.936721564138509 глубина дерева 19 минимальное количество выборок 1 лучший коэфициент детерминации: 0.9639858162388129\n"
     ]
    }
   ],
   "source": [
    "best_model_tree= None\n",
    "best_result_tree = 10000\n",
    "best_depth_tree = 0\n",
    "best_leaf_tree = 0\n",
    "best_r2_tree = 0\n",
    "for depth in range(1, 20):\n",
    "    for leaf in range(1,5):\n",
    "        model_tree =DecisionTreeRegressor(random_state=3424,max_depth=depth, min_samples_leaf= leaf)\n",
    "        model_tree.fit(features_train_scaled,target_train) \n",
    "        predictions_tree = model_tree.predict(features_valid_scaled)\n",
    "        r2_tree = r2_score(target_valid, predictions_tree)\n",
    "        result_tree =root_mean_squared_error(target_valid, predictions_tree)\n",
    "        if result_tree < best_result_tree:\n",
    "            best_model_tree = model_tree\n",
    "            best_r2_tree = r2_tree\n",
    "            best_result_tree = result_tree\n",
    "            best_depth_tree = depth\n",
    "            best_leaf_tree = leaf    \n",
    "print('RMSE лучшей модели:',best_result_tree, \n",
    "      'глубина дерева',best_depth_tree,'минимальное количество выборок', best_leaf_tree, 'лучший коэфициент детерминации:',best_r2_tree)"
   ]
  },
  {
